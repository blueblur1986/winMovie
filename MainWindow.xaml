<Window
    x:Class="WinMovie.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:media="using:Microsoft.UI.Xaml.Controls">
    <Grid>
    <ContentControl x:Name="EditorHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <Grid x:Name="EditorSurface" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="340" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="#18212D" Padding="16,0,145,0">
            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Image Source="Assets/WinMovie.png" Width="22" Height="22" />
                <TextBlock Text="WinMovie" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="·  1.0 Beta 5" Opacity="0.6" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="18,12" ColumnSpacing="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="9" Margin="0,0,18,0" VerticalAlignment="Center">
                <TextBlock Text="Edit" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="1" Content="Import media" Click="Import_Click" />
            <Button Grid.Column="2" Content="New" Click="New_Click" />
            <Button Grid.Column="3" Content="Open project" Click="Open_Click" />
            <Button Grid.Column="5" Content="Save project" Click="Save_Click" />
            <Button x:Name="ExportButton" Grid.Column="6" Content="Export MP4" Style="{StaticResource AccentButtonStyle}" Click="Export_Click" />
        </Grid>

        <Grid Grid.Row="2" Padding="18,16" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="320" />
                <ColumnDefinition Width="3*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="MediaPanel" Grid.Column="0" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="Media" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="MediaCount" HorizontalAlignment="Right" Opacity="0.7" />
                </Grid>
                <ScrollViewer x:Name="MediaScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="MediaList" Spacing="7" />
                </ScrollViewer>
                <TextBlock Grid.Row="2" Text="Drag across frames to select. Drag the yellow selection into the timeline." TextWrapping="Wrap" FontSize="12" Opacity="0.7" />
                <Grid Grid.Row="3" ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="RangeLabel" VerticalAlignment="Center" Text="Import a video to begin" />
                    <Button Grid.Column="1" Content="Add range to timeline  →" Style="{StaticResource AccentButtonStyle}" Click="AddRange_Click" />
                </Grid>
            </Grid>

            <ScrollViewer x:Name="TitleEditorScroller" Grid.Column="0" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="TitleEditorContent" Spacing="10" Padding="0,0,8,0" />
            </ScrollViewer>

            <Grid Grid.Column="1" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="Preview" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="PreviewMode" HorizontalAlignment="Right" Opacity="0.7" />
                </Grid>
                <Grid x:Name="PreviewHost" Grid.Row="1" Background="#090B0D" MinHeight="250" SizeChanged="PreviewHost_SizeChanged">
                    <media:MediaPlayerElement x:Name="Preview" AreTransportControlsEnabled="False" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    <Border x:Name="TitleBackgroundPreview" Visibility="Collapsed" Height="100" HorizontalAlignment="Stretch" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBlock x:Name="TitleShadowPreview" Visibility="Collapsed" Width="420" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black" IsHitTestVisible="False" />
                    <TextBox x:Name="TitleOverlay" Visibility="Collapsed" TextChanged="TitleOverlay_TextChanged"
                             HorizontalAlignment="Center" VerticalAlignment="Center" Width="420"
                             FontSize="27" FontWeight="SemiBold" TextAlignment="Center"
                             PlaceholderText="Click to edit title" Background="Transparent" BorderThickness="0" />
                </Grid>
                <Grid Grid.Row="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PlayButton" Content="▶ Play" Click="Play_Click" />
                    <Slider x:Name="PreviewSeek" Grid.Column="1" Minimum="0" Maximum="100" ValueChanged="PreviewSeek_ValueChanged" />
                    <TextBlock x:Name="PreviewTime" Grid.Column="2" Text="0:00" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Grid.Row="3" Text="Select a timeline clip to edit it. Timeline playback uses a background-rendered preview." TextWrapping="Wrap" FontSize="12" Opacity="0.7" />
            </Grid>
        </Grid>

        <Grid x:Name="TimelinePanel" Grid.Row="3" Padding="18,12" RowSpacing="7" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" AllowDrop="True" DragOver="Timeline_DragOver" Drop="Timeline_Drop">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="46" />
                <RowDefinition Height="96" />
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock Text="Timeline" FontSize="17" FontWeight="SemiBold" />
                <TextBlock x:Name="ProjectDuration" HorizontalAlignment="Right" Opacity="0.7" />
            </Grid>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Transitions" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.7" />
                <ComboBox x:Name="TransitionCombo" Width="185" PlaceholderText="Choose transition" SelectionChanged="TransitionCombo_SelectionChanged" />
                <TextBlock x:Name="BoundaryLabel" VerticalAlignment="Center" Margin="14,0,0,0" Opacity="0.7" />
                <NumberBox x:Name="TransitionSeconds" Width="84" SpinButtonPlacementMode="Compact" Minimum="0.05" Maximum="10" SmallChange="0.1" ValueChanged="TransitionSeconds_ValueChanged" />
                <TextBlock Text="Ctrl-click clips or Ctrl+A for batch edits. Delete removes the selection." VerticalAlignment="Center" Opacity="0.55" FontSize="11" Margin="15,0,0,0" />
            </StackPanel>
            <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="4" Width="130">
                    <TextBlock Text="Titles" FontWeight="SemiBold" />
                    <Button Content="+ Add title" Click="AddTitle_Click" />
                </StackPanel>
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                    <Canvas x:Name="TitleTrackCanvas" Height="40" Width="400" Background="#202838" AllowDrop="True" DragOver="Track_DragOver" Drop="TitleTrack_Drop" />
                </ScrollViewer>
            </Grid>
            <ScrollViewer x:Name="TimelineScroller" Grid.Row="3" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" AllowDrop="True" DragOver="Timeline_DragOver" Drop="Timeline_Drop">
                <StackPanel x:Name="TimelineList" Orientation="Horizontal" Spacing="4" MinWidth="600" Background="#1B232C" AllowDrop="True" DragOver="Timeline_DragOver" Drop="Timeline_Drop" />
            </ScrollViewer>
            <Grid Grid.Row="4" ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="4" Width="130">
                    <TextBlock Text="Music" FontWeight="SemiBold" />
                    <Button Content="+ Add music" Click="AddMusic_Click" />
                </StackPanel>
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                    <Canvas x:Name="MusicTrackCanvas" Height="40" Width="400" Background="#1F3034" AllowDrop="True" DragOver="Track_DragOver" Drop="MusicTrack_Drop" />
                </ScrollViewer>
            </Grid>
            <ScrollViewer Grid.Row="5" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="Clip" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Content="←" Click="MoveLeft_Click" ToolTipService.ToolTip="Move clip left" />
                    <Button Content="→" Click="MoveRight_Click" ToolTipService.ToolTip="Move clip right" />
                    <Button Content="Remove" Click="Remove_Click" />
                    <TextBlock Text="Trim from" VerticalAlignment="Center" />
                    <NumberBox x:Name="TrimInBox" Width="85" Minimum="0" SmallChange="0.1" SpinButtonPlacementMode="Compact" ValueChanged="Trim_ValueChanged" />
                    <TextBlock Text="to" VerticalAlignment="Center" />
                    <NumberBox x:Name="TrimOutBox" Width="85" Minimum="0" SmallChange="0.1" SpinButtonPlacementMode="Compact" ValueChanged="Trim_ValueChanged" />
                    <CheckBox x:Name="FadeInBox" Content="Fade in" Checked="InspectorCheck_Changed" Unchecked="InspectorCheck_Changed" />
                    <CheckBox x:Name="FadeOutBox" Content="Fade out" Checked="InspectorCheck_Changed" Unchecked="InspectorCheck_Changed" />
                    <TextBlock Text="Clip title" VerticalAlignment="Center" />
                    <ComboBox x:Name="TitleBox" Width="115" SelectionChanged="InspectorSelection_Changed">
                        <ComboBoxItem Content="None" /><ComboBoxItem Content="Center" /><ComboBoxItem Content="Lower third" /><ComboBoxItem Content="Opening" />
                    </ComboBox>
                    <TextBlock Text="Speed" VerticalAlignment="Center" />
                    <Button x:Name="SpeedButton" Content="100%…" Click="Speed_Click" />
                    <TextBlock Text="Volume" VerticalAlignment="Center" />
                    <Slider x:Name="VolumeSlider" Width="105" Minimum="0" Maximum="4" StepFrequency="0.05" ValueChanged="InspectorValue_Changed" />
                    <CheckBox x:Name="NormalizeBox" Content="Normalize" Checked="InspectorCheck_Changed" Unchecked="InspectorCheck_Changed" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="4" Padding="18,6">
            <TextBlock x:Name="Status" Text="Ready" Opacity="0.7" />
        </Grid>
    </Grid>
    </ContentControl>
    <Grid x:Name="ExportOverlay" Visibility="Collapsed" Background="#D90B111B" IsHitTestVisible="True">
        <Border Width="420" Padding="28" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="16">
                <TextBlock Text="Exporting your movie" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="ExportOverlayMessage" Text="Preparing clips…" TextWrapping="Wrap" />
                <ProgressBar x:Name="ExportOverlayProgress" Height="8" Minimum="0" Maximum="1" />
                <Button x:Name="ExportCancelButton" Content="Cancel export" HorizontalAlignment="Right" Click="CancelExport_Click" />
            </StackPanel>
        </Border>
    </Grid>
    </Grid>
</Window>
